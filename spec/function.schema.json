{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:nbo:spec:v1:function",
  "title": "Function",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "runtime", "handler", "artifact", "concurrency"],
  "patternProperties": { "^x-[a-z0-9]+(-[a-z0-9]+)+$": {} },
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["node"] },
        "version": { "type": "string" }
      }
    },
    "handler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "entry", "export"],
      "properties": {
        "style": { "type": "string", "enum": ["fetch"] },
        "entry": { "type": "string" },
        "export": { "type": "string" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "digest", "files"],
      "properties": {
        "type": { "type": "string", "enum": ["bundle"] },
        "path": { "type": "string" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "files": { "type": "string" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memoryMb": { "type": "integer" },
        "maxDurationSec": { "type": "integer" },
        "maxRequestBodyMb": { "type": "integer" }
      }
    },
    "concurrency": { "type": "string", "const": "multi" },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "fn.streaming",
          "fn.edge",
          "fn.waitUntil",
          "fn.arm64",
          "prerender.isr",
          "prerender.onDemand",
          "images.optimize",
          "geo.headers"
        ]
      }
    }
  }
}
